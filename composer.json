{
	"name": "dereuromark/cakephp-translate",
	"description": "A CakePHP plugin for managing translations",
	"license": "MIT",
	"type": "cakephp-plugin",
	"keywords": [
		"cakephp",
		"plugin",
		"i18n",
		"admin-panel",
		"standalone-ui",
		"l10n",
		"localization",
		"translations",
		"po-files"
	],
	"authors": [
		{
			"name": "Mark Scherer",
			"homepage": "https://www.dereuromark.de",
			"role": "Author"
		}
	],
	"homepage": "https://dereuromark.github.io/cakephp-translate/",
	"support": {
		"source": "https://github.com/dereuromark/cakephp-translate",
		"docs": "https://dereuromark.github.io/cakephp-translate/"
	},
	"require": {
		"php": ">=8.5",
		"cakephp/cakephp": "^6.0@dev",
		"friendsofcake/search": "dev-cake6"
	},
	"require-dev": {
		"dereuromark/cakephp-i18n-lint": "dev-cake6",
		"ext-json": "*",
		"cakephp/migrations": "dev-fix/6.x-cakephp-compatibility",
		"dereuromark/cakephp-queue": "dev-cake6",
		"dereuromark/cakephp-data": "dev-cake6",
		"dereuromark/cakephp-shim": "dev-cake6",
		"dereuromark/cakephp-tools": "dev-cake6",
		"fig-r/psr2r-sniffer": "dev-master",
		"phpunit/phpunit": "^13.0",
		"sepia/po-parser": "^6.0.1",
		"yandex/translate-api": "dev-master",
		"dereuromark/cakephp-audit-stash": "dev-cake6"
	},
	"suggest": {
		"dereuromark/cakephp-audit-stash": "For comprehensive audit logging of translation changes (strings and terms)",
		"dereuromark/cakephp-queue": "For application-defined background processing; no Queue import job ships with Translate",
		"yandex/translate-api": "Free Translation API Alternative",
		"friendsofcake/bootstrap-ui": "Optional form helper integration; requires a CakePHP 6-compatible version."
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Translate\\": "src/",
			"Translate\\Test\\Fixture\\": "tests/Fixture/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"TestApp\\": "tests/test_app/src/",
			"Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
			"Translate\\Test\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"cs-check": "phpcs --colors --parallel=16",
		"cs-fix": "phpcbf --colors --parallel=16",
		"stan": "phpstan analyze",
		"stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json",
		"lowest": "validate-prefer-lowest",
		"lowest-setup": "composer update --prefer-lowest --prefer-stable --prefer-dist --no-interaction && cp composer.json composer.backup && composer require --dev dereuromark/composer-prefer-lowest && mv composer.backup composer.json",
		"test": "vendor/bin/phpunit",
		"test-coverage": "vendor/bin/phpunit --log-junit tmp/coverage/unitreport.xml --coverage-html tmp/coverage --coverage-clover tmp/coverage/coverage.xml",
		"i18n-check": "i18n-lint check",
		"i18n-extract": "i18n-lint extract",
		"i18n-lint": "i18n-lint lint"
	}
}
