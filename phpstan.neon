parameters:
	level: 8
	excludePaths:
		# Optional BootstrapUI adapter awaits a CakePHP 6-compatible upstream version.
		- src/View/Helper/FormHelper.php
	paths:
		- src/
	bootstrapFiles:
		- tests/bootstrap.php
		- %rootDir%/../../../config/bootstrap.php
	ignoreErrors:
		- identifier: missingType.generics
		- identifier: missingType.iterableValue
